{
  "id": null,
  "uid": "modo-postgres-overview",
  "title": "PostgreSQL Overview - MODO",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "database",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(pg_database_size_bytes, datname)",
        "refresh": 1,
        "skipUrlSync": false,
        "queryValue": "",
        "current": {
          "text": "modo_db",
          "value": "modo_db"
        },
        "includeAll": false,
        "multi": false,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Database Size",
      "datasource": "Prometheus",
      "targets": [ { "refId": "A", "expr": "pg_database_size_bytes{datname=\"$database\"}", "instant": true } ],
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Active Connections",
      "datasource": "Prometheus",
      "targets": [ { "refId": "A", "expr": "pg_connections{state=\"active\"}", "instant": true } ],
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Total Connections",
      "datasource": "Prometheus",
      "targets": [ { "refId": "A", "expr": "pg_connections", "instant": true } ],
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Idle Connections",
      "datasource": "Prometheus",
      "targets": [ { "refId": "A", "expr": "pg_connections{state=\"idle\"}", "instant": true } ],
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Transactions Committed / s",
      "datasource": "Prometheus",
      "targets": [ { "refId": "A", "expr": "rate(pg_transactions_committed_total[1m])" } ],
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Transactions Rolled Back / s",
      "datasource": "Prometheus",
      "targets": [ { "refId": "A", "expr": "rate(pg_transactions_rolledback_total[1m])" } ],
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Rows Returned / s",
      "datasource": "Prometheus",
      "targets": [ { "refId": "A", "expr": "rate(pg_tuples_returned_total[1m])" } ],
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Rows Fetched / s",
      "datasource": "Prometheus",
      "targets": [ { "refId": "A", "expr": "rate(pg_tuples_fetched_total[1m])" } ],
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Dead Tuples",
      "datasource": "Prometheus",
      "targets": [ { "refId": "A", "expr": "pg_dead_tuples", "instant": true } ],
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "gauge",
      "title": "Cache Hit Ratio",
      "datasource": "Prometheus",
      "targets": [ { "refId": "A", "expr": "1 - (rate(pg_heap_blks_read[5m]) / (rate(pg_heap_blks_hit[5m]) + rate(pg_heap_blks_read[5m])))" } ],
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "type": "table",
      "title": "Top Tables by Size (raw SQL)",
      "datasource": "PostgreSQL",
      "targets": [ { "refId": "A", "rawSql": "SELECT schemaname AS schema, tablename AS table, pg_size_pretty(pg_total_relation_size(schemaname||'.'||tablename)) AS size, pg_total_relation_size(schemaname||'.'||tablename) AS size_bytes FROM pg_tables WHERE schemaname NOT IN ('pg_catalog','information_schema') ORDER BY pg_total_relation_size(schemaname||'.'||tablename) DESC LIMIT 10", "format": "table" } ],
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "table",
      "title": "Row Counts by Table (raw SQL)",
      "datasource": "PostgreSQL",
      "targets": [ { "refId": "A", "rawSql": "SELECT relname AS table, n_live_tup AS live_rows, n_dead_tup AS dead_rows, last_autovacuum, last_autoanalyze FROM pg_stat_user_tables ORDER BY n_live_tup DESC LIMIT 10", "format": "table" } ],
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
